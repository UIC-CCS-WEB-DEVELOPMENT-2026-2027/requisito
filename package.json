{
  "name": "requisito",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ai:diagnose": "node --env-file-if-exists=.env scripts/diagnose-ai-config.mjs",
    "api:dev": "node --env-file-if-exists=.env server/index.js",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test",
    "test:network-independent": "node --test src/tests/*.test.js src/tests/*.test.mjs scripts/*.test.mjs server/auth/*.test.mjs server/core.test.mjs server/index.test.mjs server/catalogScripts.test.mjs api/chat.test.mjs",
    "test:e2e": "playwright test",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:first-job-release": "node scripts/audit-first-job-release.mjs",
    "audit:mvp-readiness": "node scripts/audit-mvp-readiness.mjs",
    "check:mvp": "node scripts/audit-data.mjs && npm run audit:links && npm run lint && npm run test:network-independent && npm run build && npm run audit:mvp-readiness",
    "check": "node scripts/audit-data.mjs && npm run audit:links && npm test && npm run build && npm run audit:mvp-readiness",
    "db:import": "node --env-file-if-exists=.env scripts/db-import.mjs",
    "db:export": "node --env-file-if-exists=.env scripts/db-export.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/admin-create.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
