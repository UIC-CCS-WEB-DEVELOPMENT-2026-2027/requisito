AI_PROVIDER=gemini
AI_MODEL=
AI_API_KEYS=
# In-memory per-IP assistant limit per Manila calendar day (1-10000; default 100).
DAILY_LIMIT_PER_IP=100

# Local admin API. Replace the placeholder with at least 32 random characters.
PORT=8787
DATABASE_PATH=.local/requisito-admin.sqlite
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:5173
